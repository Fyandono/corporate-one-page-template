---
import AboutIntro from '../../components/sections/AboutIntro.tsx';
import BusinessSection from '../../components/sections/BusinessSection.tsx';
import ContactSection from '../../components/sections/ContactSection.tsx';
import Hero from '../../components/sections/Hero.tsx';
import ManagementSection from '../../components/sections/ManagementSection.tsx';
import NewsSection from '../../components/sections/NewsSection.tsx';
import ProseSection from '../../components/sections/ProseSection.astro';
import StatsBand from '../../components/sections/StatsBand.tsx';
import Timeline from '../../components/sections/Timeline.tsx';
import ValuesGrid from '../../components/sections/ValuesGrid.tsx';
import VisionMission from '../../components/sections/VisionMission.tsx';
import { sectionIndex } from '../../config/navigation';
import { site } from '../../config/site';
import { getLangPaths, getLocale } from '../../i18n';
import { loadAbout } from '../../lib/sections/about';
import { loadBusiness } from '../../lib/sections/business';
import { loadContact } from '../../lib/sections/contact';
import { loadHero } from '../../lib/sections/hero';
import { loadManagement } from '../../lib/sections/management';
import { loadNews } from '../../lib/sections/news';
import { loadProseSections } from '../../lib/sections/prose';
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Halaman utama one-page — hanya komposisi. Data tiap section disiapkan di src/lib/sections/;
 * `id` & nomor section berasal dari menu (src/config/navigation.ts). Section opsional mengikuti
 * `site.features`.
 */
export const getStaticPaths = () => getLangPaths();
const lang = getLocale(Astro.params.lang);

const [hero, about, management, business, proseSections, news, contact] = await Promise.all([
  loadHero(lang),
  loadAbout(lang),
  loadManagement(lang),
  loadBusiness(lang),
  loadProseSections(lang),
  site.features.news ? loadNews(lang) : undefined,
  loadContact(lang),
]);
---

<BaseLayout lang={lang}>
  <Hero {...hero} />

  <div id="about">
    <AboutIntro index={sectionIndex('about')} {...about.intro} />
    <StatsBand {...about.stats} />
    <VisionMission {...about.visionMission} />
    <ValuesGrid {...about.values} />
    <Timeline {...about.timeline} />
  </div>

  <ManagementSection id="management" index={sectionIndex('management')} {...management} />

  <BusinessSection id="business" index={sectionIndex('business')} {...business} />

  {proseSections.map(({ key, Content, ...section }, i) => (
    <ProseSection
      id={key}
      index={sectionIndex(key)}
      tone={i % 2 === 1 ? 'muted' : 'light'}
      {...section}
    >
      <Content />
    </ProseSection>
  ))}

  {news && <NewsSection id="news" index={sectionIndex('news')} {...news} />}

  <ContactSection id="contact" index={sectionIndex('contact')} {...contact} />
</BaseLayout>
